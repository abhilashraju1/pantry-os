<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="100%" height="100%">
  <rect width="400" height="300" fill="#234B3A" />
  <circle cx="200" cy="150" r="110" fill="#FAF8F3" stroke="#D79B52" stroke-width="6" />
  <circle cx="200" cy="150" r="90" fill="#556B2F" />
  <!-- Dal broth and greens elements -->
  <circle cx="170" cy="140" r="20" fill="#8FBC8F" opacity="0.8" />
  <circle cx="230" cy="150" r="25" fill="#2E8B57" opacity="0.8" />
  <circle cx="190" cy="175" r="18" fill="#DAA520" opacity="0.9" />
  <circle cx="210" cy="125" r="15" fill="#B22222" opacity="0.7" />
  <!-- Tempering mustard & cumin specks -->
  <circle cx="160" cy="160" r="3" fill="#1C1C1C" />
  <circle cx="220" cy="130" r="3" fill="#1C1C1C" />
  <circle cx="195" cy="145" r="3" fill="#1C1C1C" />
  <circle cx="240" cy="165" r="3" fill="#1C1C1C" />
  <text x="200" y="275" font-family="system-ui, sans-serif" font-size="16" font-weight="bold" fill="#FAF8F3" text-anchor="middle">ಬಸ್ಸಾರು (Bassaru &amp; Palya)</text>
