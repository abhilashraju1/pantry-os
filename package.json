{
  "name": "pantry-os",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Karnataka Vegetarian Pantry, Kitchen, POS & Commerce Platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "pnpm --filter @pantryos/api run dev",
    "dev:web": "pnpm --filter @pantryos/web run dev",
    "dev": "pnpm --parallel run dev",
    "typecheck": "pnpm -r run typecheck",
    "db:migrate": "pnpm --filter @pantryos/database run db:migrate",
    "db:seed": "pnpm --filter @pantryos/database run db:seed",
    "db:reset-demo": "pnpm --filter @pantryos/database run db:reset-demo",
    "db:bootstrap": "pnpm --filter @pantryos/database run db:bootstrap"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
